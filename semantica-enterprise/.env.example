ENVIRONMENT=development
# Optional build mirrors for restricted server networks. Keep the official
# defaults unless the deployment environment has verified internal mirrors.
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
PIP_INDEX_URL=https://pypi.org/simple
API_PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
ASR_PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
ASR_TORCHAUDIO_CPU_WHEEL_URL=https://download.pytorch.org/whl/cpu/torchaudio-2.5.1%2Bcpu-cp310-cp310-linux_x86_64.whl
# Optional model-repository mirror. Keep the official endpoint when it is
# reachable; restricted networks may use a verified compatible mirror.
HF_ENDPOINT=https://huggingface.co
HF_HUB_DISABLE_XET=1
API_BIND_ADDRESS=127.0.0.1
API_PUBLISHED_PORT=8080
INTERNAL_BIND_ADDRESS=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_CONSOLE_PORT=9001
OPENSEARCH_PUBLISHED_PORT=9200
QDRANT_PUBLISHED_PORT=6333
# Qdrant vector reads are idempotent; allow one bounded retry after a cold
# connection timeout without hiding permanent collection/configuration errors.
QDRANT_SEARCH_TIMEOUT_SECONDS=30
QDRANT_SEARCH_MAX_ATTEMPTS=2
FALKORDB_PUBLISHED_PORT=6380
MCP_PUBLISHED_PORT=8091
# Comma-separated Host headers accepted by the MCP transport when it is
# published behind a domain or reverse proxy (for example mcp.example.com).
MCP_ALLOWED_HOSTS=
# Optional public endpoints shown in the service-open UI. Leave empty when the
# corresponding service is intentionally available only on the Docker network.
MCP_PUBLIC_URL=
AGENT_PUBLIC_URL=
# Optional customer-test endpoint used only by deployment/demo tooling. Keep
# the real host in the ignored .env file, not in public documentation.
TEST_ENV_URL=
APP_SECRET_KEY=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
MINIO_ROOT_USER=semantica
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
POSTGRES_PASSWORD=replace-with-a-strong-password
RABBITMQ_PASSWORD=replace-with-a-strong-password
SOURCE_PRIVATE_HOST_ALLOWLIST=
