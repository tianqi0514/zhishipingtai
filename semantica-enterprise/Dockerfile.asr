FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    FUNASR_MODEL=sensevoice \
    FUNASR_DEVICE=cpu \
    FUNASR_PORT=8001

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git libsndfile1 curl \
    && rm -rf /var/lib/apt/lists/*

# Version is intentionally pinned.  Model weights live in the mounted cache
# volume and are not copied into application images.
RUN python -m pip install --upgrade pip \
    && pip install \
        "funasr==1.4.13" \
        "fastapi>=0.115,<1" \
        "uvicorn[standard]>=0.30,<1" \
        "python-multipart>=0.0.20,<1"

# FunASR deliberately leaves the tensor runtime to the deployer.  Pin the CPU
# wheel so this service never downloads CUDA libraries or drifts with latest.
RUN pip install --index-url https://download.pytorch.org/whl/cpu \
        "torch==2.5.1"

# Feature extraction backend matched to the exact torch build.
RUN pip install --index-url https://download.pytorch.org/whl/cpu \
        "torchaudio==2.5.1"

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=8s --start-period=600s --retries=5 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.getenv('FUNASR_PORT','8001'),timeout=5).read()" || exit 1

CMD ["sh", "-c", "funasr-server --host 0.0.0.0 --port ${FUNASR_PORT:-8001} --device ${FUNASR_DEVICE:-cpu} --model ${FUNASR_MODEL:-sensevoice}"]
