# syntax=docker/dockerfile:1.7

# Server image built only from sources committed in this repository. Unlike
# the fast local-development Dockerfile, it does not require a pre-existing
# `semantica-local:*` image on the target host.
FROM python:3.13-slim-bookworm@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e AS runtime

ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL}

RUN find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec \
    sed -i \
      -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" {} + \
    && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update \
    && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 install -y --no-install-recommends \
       ffmpeg file git git-lfs libgl1 libmagic1 fonts-wqy-zenhei \
       libreoffice-calc libreoffice-impress libreoffice-writer \
       tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY semantica-enterprise/constraints/production-py313-linux-x86_64.txt /tmp/production-constraints.txt

# Resolve the CPU builds before either Semantica or Docling is installed.
# Otherwise an unconstrained PyPI resolution can download CUDA runtime wheels
# on an ordinary x86_64 server. These versions are the pair exercised by the
# platform's Docker regression suite.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --constraint /tmp/production-constraints.txt \
      --index-url "${PYTORCH_CPU_INDEX_URL}" \
      "torch==2.13.0+cpu" "torchvision==0.28.0+cpu"

# Install the exact Semantica source versioned alongside the platform. This
# keeps the server build self-contained without copying its algorithms into
# the enterprise adapter.
WORKDIR /opt/semantica
COPY semantica/pyproject.toml semantica/README.md semantica/LICENSE semantica/MANIFEST.in ./
COPY semantica/semantica ./semantica
COPY semantica/integrations ./integrations
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --constraint /tmp/production-constraints.txt .

WORKDIR /app
COPY semantica-enterprise/pyproject.toml ./pyproject.toml
# Resolve the enterprise and multimodal dependency set before copying source,
# so ordinary application changes retain this expensive layer.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --constraint /tmp/production-constraints.txt ".[m4]" \
    && pip install --constraint /tmp/production-constraints.txt \
      "pytest>=8.3" "pytest-asyncio>=0.25" "pytest-cov>=6.0"

COPY semantica-enterprise/apps ./apps
COPY semantica-enterprise/packages ./packages
COPY semantica-enterprise/scripts ./scripts
COPY semantica-enterprise/demo ./demo
RUN pip install --no-deps -e . \
    && python -m pip check \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --home /app --shell /usr/sbin/nologin app \
    && mkdir -p /app/data \
    && chown -R app:app /app

ENV HOME=/app
USER app
EXPOSE 8080
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
